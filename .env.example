# Токен Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# Ключ PlusVibe API (https://plusvibeapi.ru)
PLUSVIBE_API_KEY=

# Системный промпт (необязательно)
SYSTEM_PROMPT=Ты — дружелюбный ИИ-ассистент в Telegram-чате. Отвечай по делу, живо и с юмором.

# Дополнительное имя, на которое бот реагирует (необязательно)
# BOT_NAME=Ботик

# Модели (необязательно, значения по умолчанию)
# CHAT_MODEL=gpt-6-luna
# Вторая чат-модель на выбор пользователю (необязательно)
# CHAT_MODEL2=GigaChat-2
# Ключевые слова вызова второй модели в сообщении, через запятую
# MODEL2_KEYWORDS=гигачат,гига,gigachat,giga
# Ключ авторизации GigaChat API Сбера: base64(client_id:client_secret) из личного кабинета
# GIGACHAT_AUTH_KEY=
# GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_BASE=https://api.giga.chat
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# false — отключить проверку TLS (если сертификат Минцифры не установлен в систему)
# Проверка идёт по системному хранилищу CA — туда и нужно ставить сертификат Минцифры
# GIGACHAT_VERIFY_SSL=true
# IMAGE_MODEL=gpt-image-2:white
# FACTCHECK_MODEL=perplexity/sonar

# Системный промпт фактчекера (необязательно)
# FACTCHECK_SYSTEM_PROMPT=Ты - профессиональный факт-чекер...

# Системный промпт поиска информации без оценки достоверности (необязательно)
# SEARCH_SYSTEM_PROMPT=Ты - поисковый ассистент...

# Базовый URL API (необязательно)
# PLUSVIBE_BASE=https://plusvibeapi.ru

# Глубина памяти диалога, сообщений (необязательно)
# HISTORY_LIMIT=20

# Лимит токенов на ответ основной модели (необязательно; по умолчанию не ограничено)
# MAX_TOKENS=1000

# Логирование в файл с ротацией (необязательно; пустой LOG_FILE = только консоль)
# LOG_FILE=bot.log
# LOG_MAX_BYTES=5242880
# LOG_BACKUPS=3

# Режим запуска: polling (по умолчанию, для локального компьютера) или webhook
# BOT_MODE=polling

# Для режима webhook (нужен публичный HTTPS-адрес, например за reverse proxy или туннелем ngrok/cloudflared):
# WEBHOOK_URL=https://example.com
# WEBHOOK_PATH=webhook
# WEBHOOK_LISTEN=0.0.0.0
# WEBHOOK_PORT=8080
# WEBHOOK_SECRET_TOKEN=  # необязательный секрет для проверки запросов от Telegram

# Антиспам генерации картинок: минимальный интервал между генерациями, секунды (по умолчанию 600 = 10 минут)
# IMAGE_COOLDOWN_SECONDS=600

# Опрос асинхронной джобы генерации: интервал и общий таймаут, секунды
# IMAGE_POLL_INTERVAL=5
# IMAGE_JOB_TIMEOUT=300

# Фразы бота на время ожидания (через |; по умолчанию 5 заготовленных в коде)
# IMAGE_COOLDOWN_PHRASES=Кисти отдыхают|Холст сохнет

# Мгновенные заглушки на время долгих операций, например генерации картинки (через |)
# ACK_PHRASES=Уже берусь за дело|Секундочку, творю
